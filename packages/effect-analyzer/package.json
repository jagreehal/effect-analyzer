{
  "name": "effect-analyzer",
  "version": "3.1.0",
  "type": "module",
  "description": "Static analysis for Effect-TS code. Analyze Effect code to extract structure, calculate complexity, and generate visualizations.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./src/register-node-ts-morph.ts"
  ],
  "bin": {
    "effect-analyze": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./analysis": {
      "types": "./dist/analysis-entry.d.ts",
      "import": "./dist/analysis.js",
      "require": "./dist/analysis.cjs"
    },
    "./diagram": {
      "types": "./dist/diagram-entry.d.ts",
      "import": "./dist/diagram.js",
      "require": "./dist/diagram.cjs"
    },
    "./rules": {
      "types": "./dist/rules-entry.d.ts",
      "import": "./dist/rules.js",
      "require": "./dist/rules.cjs"
    },
    "./migration": {
      "types": "./dist/migration-entry.d.ts",
      "import": "./dist/migration.js",
      "require": "./dist/migration.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./effect-workflow": {
      "types": "./dist/effect-workflow.d.ts",
      "import": "./dist/effect-workflow.js",
      "require": "./dist/effect-workflow.cjs"
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "state-machine-conventions.md"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declarationMap false",
    "lsp": "node dist/lsp/server.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "oxlint src --tsconfig tsconfig.lint.json && node scripts/check-imports.mjs",
    "lint:fix": "oxlint src --tsconfig tsconfig.lint.json --fix && node scripts/check-imports.mjs",
    "clean": "rm -rf dist",
    "quality": "pnpm type-check && pnpm test && pnpm lint",
    "effect:fetch": "tsx scripts/fetch-effect-repo.ts",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "mutation": "stryker run",
    "mutation:incremental": "stryker run --incremental",
    "test:mutation-sandbox": "node scripts/test-mutation-sandbox.mjs"
  },
  "keywords": [
    "effect",
    "effect-ts",
    "static-analysis",
    "ts-morph",
    "typescript",
    "visualization",
    "mermaid",
    "functional-programming"
  ],
  "author": "Jag Reehal <jag@jagreehal.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/effect-analyzer.git",
    "directory": "packages/effect-analyzer"
  },
  "bugs": {
    "url": "https://github.com/jagreehal/effect-analyzer/issues"
  },
  "homepage": "https://github.com/jagreehal/effect-analyzer/tree/main/packages/effect-analyzer#readme",
  "peerDependencies": {
    "effect": "^4.0.0-beta.101"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": false
    }
  },
  "dependencies": {
    "@effect/tsgo": "0.37.0",
    "ts-morph": "^28.0.0",
    "tsx": "4.23.12"
  },
  "optionalDependencies": {
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.13"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@typeonce/effect-machine": "0.7.0",
    "@types/node": "^26.2.0",
    "effect": "4.0.0-rc.109",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "ts-morph": "^28.0.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
